# Copier en .env et remplir. Ne jamais committer le vrai fichier .env.
# Mise en place détaillée : README.md, section « Base de données ».

# Base locale lancée par : npx prisma dev --name ralli --detach -p 51213 -P 51214 --shadow-db-port 51215
# En local, les deux URL sont identiques (pas de pooler).
# Plus tard, avec Neon : DATABASE_URL = connexion poolée (hôte "-pooler"), DIRECT_URL = connexion directe.
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"
DIRECT_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"

# Auth.js : secret de signature des sessions. Générer avec : openssl rand -base64 32
AUTH_SECRET=""

# Secret partagé pour la route du bonus hebdomadaire (Vercel Cron envoie "Authorization: Bearer <CRON_SECRET>").
CRON_SECRET=""
