// Schéma Ralli (MVP). Identifiants : cuid (non devinables), jamais d'entier séquentiel.
// Conventions : code en anglais, vocabulaire neutre (prediction, committedAces, payout).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────── Enums ───────────────────────────────

enum ClubRole {
  MEMBER
  ADMIN
}

enum ClubRequestStatus {
  PENDING // en attente d'examen par l'équipe Ralli
  APPROVED // le compte peut créer un club
  REFUSED
}

enum StoryKind {
  CLUB_POST // annonce d'un admin ou d'un capitaine
  WIN_CARD // ralli gagnant partagé par un membre (tranche 28)
}

enum TeamKind {
  CLUB // équipe d'un club Ralli, avec un capitaine
  EXTERNAL // adversaire hors Ralli, géré par le club Ralli qui l'a créé, sans capitaine
}

// Échelle FFT ordonnée (du plus faible au plus fort). L'ordre et le rating
// numérique sont définis dans la config des cotes, pas ici.
enum FftRank {
  NC
  R40
  R30_5
  R30_4
  R30_3
  R30_2
  R30_1
  R30
  R15_5
  R15_4
  R15_3
  R15_2
  R15_1
  R15
  R5_6
  R4_6
  R3_6
  R2_6
  R1_6
  R0
  RM2_6 // -2/6
  RM4_6 // -4/6
  RM15 // -15
  RM30 // -30
  PREMIERE_SERIE // 1re série (numérotés), échelon unique
}

// Statut STOCKÉ. LOCKED n'est jamais stocké : il est dérivé à la lecture
// (status = OPEN et heure serveur >= predictionsCloseAt).
enum EncounterStatus {
  DRAFT
  OPEN
  SCORE_PROPOSED
  DISPUTED
  CONFIRMED
  CANCELLED
}

enum MatchKind {
  SINGLES
  DOUBLES
}

enum Side {
  HOME
  AWAY
}

enum MatchOutcome {
  COMPLETED // match joué jusqu'au bout
  RETIRED // abandon : le vainqueur est déclaré, règlement normal
  WALKOVER // WO : le vainqueur est déclaré, règlement normal
  NOT_PLAYED // non joué : pronostics remboursés
}

enum TournamentStatus {
  DRAFT // en préparation : visible des admins seulement
  OPEN // publié : tableau et cotes visibles, pronostics ouverts match par match
  FINISHED // finale jouée
  CANCELLED // annulé : pronostics remboursés
}

enum PredictionStatus {
  PENDING
  WON
  LOST
  REFUNDED
}

enum LedgerType {
  SIGNUP_BONUS // +1000 à l'inscription
  WEEKLY_BONUS // +200 le lundi si solde < 500
  DAILY_LOGIN_BONUS // +10 à la première ouverture de l'app de chaque jour (heure de Paris)
  STREAK_BONUS // +50 en plus au 7e jour de connexion d'affilée (puis tous les 7 jours)
  PREDICTION_COMMIT // Aces engagés (montant négatif)
  PREDICTION_PAYOUT // Aces gagnés = engagés × cote (positif)
  PREDICTION_REFUND // remboursement (match non joué, rencontre annulée)
}

// ─────────────────────────────── Comptes et clubs ───────────────────────────────

model User {
  id                 String    @id @default(cuid())
  email              String    @unique // stocké en minuscules
  passwordHash       String
  displayName        String // pseudo public, affiché dans les classements
  displayNameKey     String    @unique // pseudo en minuscules, pour l'unicité insensible à la casse
  ageConfirmedAt     DateTime // héritage : date de la case « 18 ans ou plus », supprimée ; reçoit la date d'inscription (à retirer par une migration)
  mustChangePassword Boolean   @default(false) // posé par `npm run reset-password`
  avatarKey          String    @default("service") // avatar prédéfini (src/lib/avatars.ts)
  avatarPhotoAt      DateTime? // date de la photo importée (fichier dans le dossier avatar/) ; null = pas de photo
  onboardingSeenAt   DateTime? // guide du premier lancement vu ou passé ; null = à montrer (comptes existants : marqués vus par la migration)
  resultsSeenAt      DateTime? // les pronostics réglés avant cette date ont déjà été montrés dans le récapitulatif
  // « Rencontres à proximité » (tranche 32) : privé, jamais montré aux autres. postalCode saisi par la personne (facultatif),
  // commune + position = centre de la commune, calculés à l'enregistrement (geo.api.gouv.fr). Aucune adresse précise.
  postalCode         String?
  commune            String?
  latitude           Float?
  longitude          Float?
  nearbyRadiusKm     Int       @default(0) // rayon « Interclubs à venir » et « Interclub à proximité », réglable par la personne : 0 (mes clubs, défaut), 1 à 200 km, 999 (toute la France)
  tournamentRadiusKm Int       @default(0) // rayon « Tournoi à venir » (mêmes valeurs) ; 0 par défaut : les tournois de mes clubs
  profilePublic      Boolean   @default(true) // profil visible des membres des clubs en commun (tranche 39) ; false = avatar et pseudo seulement
  createdAt          DateTime  @default(now())

  memberships         ClubMembership[]
  clubsCreated        Club[]                @relation("ClubCreatedBy")
  captainOf           Team[]                @relation("TeamCaptain")
  player              Player?
  predictions         Prediction[]
  ledgerEntries       LedgerEntry[]
  encountersCreated   Encounter[]           @relation("EncounterCreatedBy")
  encountersArchived  Encounter[]           @relation("EncounterArchivedBy")
  encounterEvents     EncounterEvent[]
  clubRequests        ClubCreationRequest[]
  stories             Story[]               @relation("StoryAuthor")
  storiesDeleted      Story[]               @relation("StoryDeletedBy")
  storyViews          StoryView[]
  storyReactions      StoryReaction[]       @relation("StoryReactor")
  storyReports        StoryReport[]         @relation("StoryReporter")
  storyReportsHandled StoryReport[]         @relation("StoryReportHandler")
  tournamentsCreated  Tournament[]          @relation("TournamentCreatedBy")
  refereeOf           TournamentReferee[]   @relation("TournamentRefereeUser")
  refereesAdded       TournamentReferee[]   @relation("TournamentRefereeAddedBy")
  removedFrom         ClubRemoval[]         @relation("RemovedUser")
  removalsMade        ClubRemoval[]         @relation("RemovedBy")
}

/// Demande d'un utilisateur pour devenir admin d'un club (et donc pouvoir en créer un). Examinée par l'équipe Ralli.
model ClubCreationRequest {
  id            String            @id @default(cuid())
  userId        String
  fullName      String
  clubName      String
  city          String
  role          String // fonction dans le club
  fftNumber     String // numéro d'affiliation FFT du club
  website       String?
  phone         String
  message       String?
  status        ClubRequestStatus @default(PENDING)
  refusalReason String?
  decidedAt     DateTime?
  clubId        String? // club créé grâce à cette demande ; null = droit pas encore utilisé
  createdAt     DateTime          @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, status])
}

model Club {
  id          String   @id @default(cuid())
  name        String
  createdById String
  createdAt   DateTime @default(now())

  // Fiche du club : tout est facultatif, rempli par les admins. logoUpdatedAt = null : pas de logo.
  foundedYear   Int?
  licenseeCount Int?
  address       String?
  postalCode    String?
  city          String?
  websiteUrl    String?
  description   String?
  indoorCourts  Int?
  outdoorCourts Int?
  logoUpdatedAt DateTime?

  // Carte des clubs (tranche C) : calculés à l'enregistrement de la fiche (API adresse de l'État pour la position,
  // code postal pour la région). Null = club pas localisé / région inconnue.
  latitude  Float?
  longitude Float?
  region    String?

  // Page publique (tranche 34) : /c/<slug>, visible sans compte quand un admin l'active. Le slug est créé à la première activation.
  publicPage Boolean @default(false)
  slug       String? @unique

  // Suppression « douce » (tranche 34) : le club disparaît partout, les données restent. deletedMembership garde qui était membre
  // (et son rôle) pour pouvoir le rétablir à la main ; les adhésions elles-mêmes sont retirées.
  deletedAt         DateTime?
  deletedById       String?
  deletedMembership Json?

  createdBy        User              @relation("ClubCreatedBy", fields: [createdById], references: [id])
  memberships      ClubMembership[]
  teams            Team[]
  players          Player[]
  encounters       Encounter[]
  stories          Story[]
  storyCollections StoryCollection[]
  removals         ClubRemoval[]
  tournaments      Tournament[]
}

model ClubMembership {
  userId   String
  clubId   String
  role     ClubRole @default(MEMBER)
  joinedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@id([userId, clubId])
  @@index([clubId])
}

// Un membre retiré par un admin. Tant que cette ligne existe, « Rejoindre le club » en un clic est refusé :
// la personne doit demander à revenir (requestedAt non vide = demande en attente, que les admins acceptent ou refusent).
model ClubRemoval {
  userId      String
  clubId      String
  removedAt   DateTime  @default(now())
  removedById String
  requestedAt DateTime?

  user      User @relation("RemovedUser", fields: [userId], references: [id], onDelete: Cascade)
  club      Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
  removedBy User @relation("RemovedBy", fields: [removedById], references: [id])

  @@id([userId, clubId])
  @@index([clubId, requestedAt])
}

// ─────────────────────────────── Équipes et joueurs ───────────────────────────────

model Team {
  id               String   @id @default(cuid())
  clubId           String // club Ralli propriétaire (pour EXTERNAL : le club qui l'a créée)
  kind             TeamKind @default(CLUB)
  name             String // ex. « Messieurs 1 »
  externalClubName String? // EXTERNAL uniquement : nom du club adverse réel
  captainId        String? // CLUB : obligatoire (contrôle applicatif) ; EXTERNAL : toujours null
  createdAt        DateTime @default(now())

  club           Club         @relation(fields: [clubId], references: [id], onDelete: Cascade)
  captain        User?        @relation("TeamCaptain", fields: [captainId], references: [id], onDelete: SetNull)
  players        TeamPlayer[]
  stories        Story[]
  homeEncounters Encounter[]  @relation("HomeTeam")
  awayEncounters Encounter[]  @relation("AwayTeam")

  @@unique([clubId, name])
  @@index([captainId])
}

// Personne qui joue. Peut exister sans compte. Liée à au plus un User.
model Player {
  id               String    @id @default(cuid())
  clubId           String // club Ralli qui gère la fiche (pour un joueur externe : le club qui l'a saisi)
  firstName        String
  lastName         String // affiché publiquement sous la forme « Prénom N. »
  fftRank          FftRank // niveau déclaré, saisi à la main
  userId           String?   @unique // lien optionnel ; refusé tant que le joueur est dans une rencontre non réglée
  birthDate        DateTime? @db.Date // facultative, visible des admins du club seulement (jamais sur les pages publiques ni pour les membres)
  externalClubName String? // joueur d'un autre club inscrit à un tournoi : son club en texte libre (jamais listé parmi les joueurs du club)
  createdAt        DateTime  @default(now())

  club              Club              @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user              User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  teams             TeamPlayer[]
  homeMatches       Match[]           @relation("HomePlayer")
  awayMatches       Match[]           @relation("AwayPlayer")
  homeMatches2      Match[]           @relation("HomePlayer2")
  awayMatches2      Match[]           @relation("AwayPlayer2")
  tournamentEntries TournamentEntry[]
  tournamentHome    TournamentMatch[] @relation("TournamentHomePlayer")
  tournamentAway    TournamentMatch[] @relation("TournamentAwayPlayer")

  @@index([clubId])
}

model TeamPlayer {
  teamId   String
  playerId String
  addedAt  DateTime @default(now())

  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@id([teamId, playerId])
  @@index([playerId])
}

// ─────────────────────────────── Rencontres et matchs ───────────────────────────────

model Encounter {
  id                 String          @id @default(cuid())
  organizerClubId    String // le club Ralli responsable (« club domicile » de la règle de confirmation)
  homeTeamId         String
  awayTeamId         String
  startsAt           DateTime // UTC ; heure de début (modifiable par un report)
  // Fermeture des pronostics. = startsAt à la publication et lors d'un report AVANT le début ;
  // inchangée lors d'un report APRÈS le début (les pronostics restent fermés).
  predictionsCloseAt DateTime
  status             EncounterStatus @default(DRAFT)
  createdById        String
  scoreProposedById  String? // pour la règle des deux personnes distinctes
  settledAt          DateTime? // posé une seule fois, dans la transaction de règlement (idempotence)
  archivedAt         DateTime? // rencontre rangée dans les archives du club (null = visible) ; réversible, rien n'est supprimé
  archivedById       String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  organizerClub Club             @relation(fields: [organizerClubId], references: [id], onDelete: Restrict)
  homeTeam      Team             @relation("HomeTeam", fields: [homeTeamId], references: [id], onDelete: Restrict)
  awayTeam      Team             @relation("AwayTeam", fields: [awayTeamId], references: [id], onDelete: Restrict)
  createdBy     User             @relation("EncounterCreatedBy", fields: [createdById], references: [id])
  archivedBy    User?            @relation("EncounterArchivedBy", fields: [archivedById], references: [id], onDelete: SetNull)
  matches       Match[]
  events        EncounterEvent[]

  @@index([organizerClubId])
  @@index([homeTeamId])
  @@index([awayTeamId])
  @@index([status, startsAt])
  @@index([status, predictionsCloseAt])
}

// Journal des transitions d'état (audit : qui a proposé, contesté, tranché, annulé).
model EncounterEvent {
  id          String          @id @default(cuid())
  encounterId String
  fromStatus  EncounterStatus
  toStatus    EncounterStatus
  actorId     String? // null si action système
  note        String? // motif de contestation, d'annulation…
  payload     Json? // ex. scores proposés au moment de la transition
  createdAt   DateTime        @default(now())

  encounter Encounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  actor     User?     @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([encounterId, createdAt])
}

model Match {
  id            String    @id @default(cuid())
  encounterId   String
  order         Int // 1, 2, 3… ordre de création (l'affichage met les simples avant les doubles)
  kind          MatchKind @default(SINGLES)
  // Points que vaut le match dans le score final de la rencontre : 1 ou 2 (au choix du club, surtout pour un double).
  points        Int       @default(1)
  // Simple : un joueur par côté. Double : homePlayerId + homePlayer2Id contre awayPlayerId + awayPlayer2Id.
  homePlayerId  String
  awayPlayerId  String
  homePlayer2Id String?
  awayPlayer2Id String?

  // Cotes figées au passage DRAFT → OPEN (copiées ensuite sur chaque pronostic).
  // Stockées en centièmes entiers (156 = 1,56) pour un calcul exact sans flottants.
  oddsHomeX100   Int?
  oddsAwayX100   Int?
  oddsComputedAt DateTime?
  oddsInputs     Json? // ratings, forme, H2H, P, version des constantes : pour le backtest

  // Match retiré ou modifié après publication : ses pronostics sont remboursés et, en cas de
  // modification, un match de remplacement est créé (numéro suivant, nouvelles cotes).
  voidedAt DateTime?

  // Résultat (proposé, puis éventuellement corrigé par l'arbitrage admin).
  outcome    MatchOutcome?
  winnerSide Side? // null si NOT_PLAYED
  sets       Json? // [{ "home": 6, "away": 4 }, …, { "home": 10, "away": 8, "superTiebreak": true }]

  encounter   Encounter    @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  homePlayer  Player       @relation("HomePlayer", fields: [homePlayerId], references: [id], onDelete: Restrict)
  awayPlayer  Player       @relation("AwayPlayer", fields: [awayPlayerId], references: [id], onDelete: Restrict)
  homePlayer2 Player?      @relation("HomePlayer2", fields: [homePlayer2Id], references: [id], onDelete: Restrict)
  awayPlayer2 Player?      @relation("AwayPlayer2", fields: [awayPlayer2Id], references: [id], onDelete: Restrict)
  predictions Prediction[]

  @@unique([encounterId, order])
  @@index([homePlayerId])
  @@index([awayPlayerId])
  @@index([homePlayer2Id])
  @@index([awayPlayer2Id])
}

// ─────────────────────────────── Pronostics et portefeuille ───────────────────────────────

model Prediction {
  id                String           @id @default(cuid())
  userId            String
  // Un pronostic porte sur UN match d'interclubs OU sur UN match de tournoi (CHECK en base : exactement l'un des deux).
  matchId           String?
  tournamentMatchId String?
  pickedSide        Side
  committedAces     Int // entier, ≥ 10
  oddsX100          Int // cote figée au moment de la validation
  status            PredictionStatus @default(PENDING)
  payoutAces        Int? // computePayout(committedAces, oddsX100) si WON (src/lib/predictions/payout.ts) ; 0 si LOST ; committedAces si REFUNDED
  createdAt         DateTime         @default(now())
  settledAt         DateTime?

  user            User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  match           Match?           @relation(fields: [matchId], references: [id], onDelete: Restrict)
  tournamentMatch TournamentMatch? @relation(fields: [tournamentMatchId], references: [id], onDelete: Restrict)
  ledgerEntries   LedgerEntry[]
  stories         Story[]

  @@unique([userId, matchId]) // un pronostic par match et par utilisateur
  @@unique([userId, tournamentMatchId])
  @@index([matchId])
  @@index([tournamentMatchId])
  @@index([userId, settledAt])
}

// Ledger append-only (UPDATE et DELETE bloqués par un trigger dans la migration).
// Solde = SUM(amount) des écritures de l'utilisateur.
model LedgerEntry {
  id             String     @id @default(cuid())
  userId         String
  type           LedgerType
  amount         Int // signé : négatif pour un engagement, positif sinon
  predictionId   String?
  // Clé d'idempotence unique, ex. « signup:<userId> », « weekly:<userId>:2026-W41 »,
  // « commit:<predictionId> », « payout:<predictionId> », « refund:<predictionId> »,
  // « daily:<userId>:2026-10-12 » et « streak:<userId>:2026-10-12 » (jour de Paris).
  idempotencyKey String     @unique
  createdAt      DateTime   @default(now())

  user       User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  prediction Prediction? @relation(fields: [predictionId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([predictionId])
}

// ─────────────────────────────── Stories ───────────────────────────────

/// Annonce visible 24 h par les membres du club ; l'admin peut aussi la garder sur le « à la une » du club (onWall).
/// Supprimée = deletedAt posé (trace conservée pour les admins), jamais effacée.
model Story {
  id           String    @id @default(cuid())
  clubId       String
  authorId     String
  teamId       String? // story d'équipe publiée par un capitaine : sert d'étiquette ; null = tout le club
  kind         StoryKind @default(CLUB_POST)
  body         String // 280 caractères au plus (contrôle applicatif)
  background   String // clé de fond de couleur (src/lib/stories.ts)
  collectionId String? // collection de la une (« à la une ») qui garde la story après ses 24 h ; null = pas à la une
  // Ralli gagnant partagé (kind = WIN_CARD) : le pronostic réglé « gagné » dont la carte est tirée ; null pour une annonce.
  // body = le commentaire (0 à 140 caractères). Une seule carte non supprimée par pronostic : index unique partiel dans la migration.
  predictionId String?
  createdAt    DateTime  @default(now())
  expiresAt    DateTime // createdAt + 24 h
  deletedAt    DateTime?
  deletedById  String?

  club       Club             @relation(fields: [clubId], references: [id], onDelete: Cascade)
  author     User             @relation("StoryAuthor", fields: [authorId], references: [id])
  team       Team?            @relation(fields: [teamId], references: [id], onDelete: SetNull)
  collection StoryCollection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  deletedBy  User?            @relation("StoryDeletedBy", fields: [deletedById], references: [id])
  prediction Prediction?      @relation(fields: [predictionId], references: [id], onDelete: SetNull)
  views      StoryView[]
  reactions  StoryReaction[]
  reports    StoryReport[]

  @@index([clubId, expiresAt])
  @@index([collectionId])
  @@index([predictionId])
}

/// Collection à la une du club (comme les « à la une » d'Instagram) : un nom, plusieurs stories gardées après leurs 24 h.
/// Une seule collection épinglée par club (index unique partiel) ; une collection sans story vivante est supprimée.
model StoryCollection {
  id        String    @id @default(cuid())
  clubId    String
  name      String // 1 à 40 caractères
  nameKey   String // nom en minuscules : deux collections d'un club ne portent pas le même nom
  pinnedAt  DateTime?
  createdAt DateTime  @default(now())

  club    Club    @relation(fields: [clubId], references: [id], onDelete: Cascade)
  stories Story[]

  @@unique([clubId, nameKey])
}

/// Réaction 🎾 à une carte de ralli gagnant : une par membre et par carte, retirable.
model StoryReaction {
  storyId   String
  userId    String
  createdAt DateTime @default(now())

  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)
  user  User  @relation("StoryReactor", fields: [userId], references: [id], onDelete: Cascade)

  @@id([storyId, userId])
  @@index([userId])
}

/// Signalement d'une carte par un membre du club (un par membre et par carte). Traité (handledAt) par un admin du club :
/// carte supprimée ou signalement écarté. L'auteur de la carte ne voit jamais qui a signalé.
model StoryReport {
  storyId     String
  reporterId  String
  reason      String? // 200 caractères au plus
  createdAt   DateTime  @default(now())
  handledAt   DateTime?
  handledById String?

  story     Story @relation(fields: [storyId], references: [id], onDelete: Cascade)
  reporter  User  @relation("StoryReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  handledBy User? @relation("StoryReportHandler", fields: [handledById], references: [id], onDelete: SetNull)

  @@id([storyId, reporterId])
  @@index([storyId, handledAt])
}

model StoryView {
  storyId String
  userId  String
  seenAt  DateTime @default(now())

  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([storyId, userId])
  @@index([userId])
}

// ─────────────────────────────── Tournois (tranche 36) ───────────────────────────────
// Tableau à élimination directe (4, 8, 16 ou 32 joueurs) saisi par les admins du club. Chaque match a son heure de début, ses cotes
// (figées quand ses deux joueurs sont connus) et ses pronostics ; l'admin saisit le résultat, qui règle les pronostics du match
// et fait avancer le vainqueur. Tous les matchs du tableau existent dès la création ; ceux des tours suivants sont « vides » jusqu'à l'arrivée des joueurs.
model Tournament {
  id          String           @id @default(cuid())
  clubId      String
  name        String
  drawSize    Int // 4, 8, 16 ou 32 (CHECK en base)
  startsAt    DateTime // début du tournoi (affichage)
  status      TournamentStatus @default(DRAFT)
  createdById String
  createdAt   DateTime         @default(now())
  publishedAt DateTime?
  finishedAt  DateTime?
  winnerId    String? // joueur vainqueur (fiche), posé à la finale
  tableLabel  String? // sigle du tableau pour l'affiche (SM, SD, FT4SD…)
  venue       String? // lieu affiché sur l'affiche (à défaut : l'adresse du club)

  club      Club                @relation(fields: [clubId], references: [id], onDelete: Restrict)
  createdBy User                @relation("TournamentCreatedBy", fields: [createdById], references: [id])
  entries   TournamentEntry[]
  matches   TournamentMatch[]
  referees  TournamentReferee[]

  @@index([clubId, status])
}

// Juge-arbitre d'un tournoi : nommé par un admin du club (membre du club), autant que nécessaire. Prépare le tableau, fixe les heures,
// saisit les résultats (qui règlent les pronostics) ; ne crée, ne publie ni n'annule. Ne pronostique pas ce tournoi.
model TournamentReferee {
  tournamentId String
  userId       String
  addedById    String
  addedAt      DateTime @default(now())

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user       User       @relation("TournamentRefereeUser", fields: [userId], references: [id], onDelete: Cascade)
  addedBy    User       @relation("TournamentRefereeAddedBy", fields: [addedById], references: [id])

  @@id([tournamentId, userId])
  @@index([userId])
}

model TournamentEntry {
  tournamentId String
  playerId     String
  addedAt      DateTime @default(now())

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  player     Player     @relation(fields: [playerId], references: [id], onDelete: Restrict)

  @@id([tournamentId, playerId])
  @@index([playerId])
}

model TournamentMatch {
  id             String        @id @default(cuid())
  tournamentId   String
  round          Int // 1 = premier tour … dernier = finale
  position       Int // 0, 1, 2… dans le tour (de haut en bas du tableau)
  homePlayerId   String?
  awayPlayerId   String?
  startsAt       DateTime? // heure de début, saisie par l'admin ; les pronostics ferment à cette heure
  oddsHomeX100   Int?
  oddsAwayX100   Int?
  oddsComputedAt DateTime?
  oddsInputs     Json?
  outcome        MatchOutcome?
  winnerSide     Side?
  sets           Json?
  settledAt      DateTime? // posé une seule fois, au règlement des pronostics

  tournament  Tournament   @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  homePlayer  Player?      @relation("TournamentHomePlayer", fields: [homePlayerId], references: [id], onDelete: Restrict)
  awayPlayer  Player?      @relation("TournamentAwayPlayer", fields: [awayPlayerId], references: [id], onDelete: Restrict)
  predictions Prediction[]

  @@unique([tournamentId, round, position])
  @@index([homePlayerId])
  @@index([awayPlayerId])
}
